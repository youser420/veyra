# Required
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Must match VERIFICATION_ENGINE_SECRET set on the web app (Vercel).
# The engine rejects every /verify request if this is unset.
VERIFICATION_ENGINE_SECRET=your_shared_secret_key

# LLM judge (recommended). Without a key, open-ended probes fall back to keyword
# heuristics, which are much easier to game. Each run records which mode was used.
ANTHROPIC_API_KEY=
# VERIFY_JUDGE_MODEL=claude-opus-5
# VERIFY_JUDGE=off

# Optional
# Days between scheduled monitor re-checks (default: 7).
MONITOR_INTERVAL_DAYS=7
# Per-call timeout and max parallel calls to a seller's endpoint.
# AGENT_CALL_TIMEOUT_S=60
# AGENT_MAX_CONCURRENCY=3
# Local development only: allow localhost / private-network endpoints (e.g. scripts/mock_agent.py).
# Never enable in production — it lets sellers point the engine at internal services.
# ALLOW_PRIVATE_ENDPOINTS=true
# Only needed if you verify Dify agents.
DIFY_API_KEY=
